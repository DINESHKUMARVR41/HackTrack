# Optional AI competition/message extraction. Get a key at https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Choose one reminder provider: ntfy (recommended), textbee, or email
REMINDER_MODE=ntfy

# ---------------- ntfy push notifications ----------------
# Install the ntfy app on your phone, subscribe to the same topic, and use a long random topic name.
# Anyone who knows a public ntfy topic name may be able to read/post to it, so do not use a guessable topic.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=replace-with-a-long-random-topic-name
# Optional token if you use an authenticated ntfy server/account
NTFY_TOKEN=
NTFY_PRIORITY=3

# ---------------- Textbee SMS (optional alternative) ----------------
# Create account, register Android phone, and create an API key at https://textbee.dev/
TEXTBEE_API_KEY=
# International phone number format, e.g. +91XXXXXXXXXX. Multiple recipients separated by commas.
TEXTBEE_RECIPIENTS=
TEXTBEE_API_URL=https://api.textbee.dev/api/v1/gateway/send-sms

# ---------------- Email (optional alternative) ----------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REMINDER_EMAIL=

# Local scheduler checks every minute while this process is running.
# For hosted deployment, set false and run the scheduler separately to avoid duplicate schedulers.
ENABLE_LOCAL_SCHEDULER=true
DATABASE_PATH=hacktrack.db
