# AI extraction (optional; obtain a key at https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Email reminders (optional). For Gmail, use an App Password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REMINDER_EMAIL=

# Local scheduler is useful for local development. On production, use a persistent worker/cron.
ENABLE_LOCAL_SCHEDULER=true
DATABASE_PATH=hacktrack.db
